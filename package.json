{
  "name": "clima-ec",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ClimaEC: pronóstico, mapa de lluvia y alertas de El Niño para Ecuador (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
